# Sandbox — learner code is untrusted and only ever runs here.
E2B_API_KEY=e2b_your_key_here

# LLM, via the LiteLLM proxy.
LITELLM_BASE_URL=https://your-gateway/litellm/v1
LITELLM_API_KEY=sk-your-virtual-key
LITELLM_MODEL=kimi-k2.6
LITELLM_TIMEOUT_SECONDS=180

# Which approach this checkout is. Set per branch; see README.
CODE_CAT_APPROACH=B

# Voice / open-ended adaptive assessment — local secrets.
# Copy from .env.example and fill in. Never commit this file.

# --- LiteLLM (picker + open rubric grader — NOT Gemini) ----------------------
LITELLM_BASE_URL=https://your-gateway/litellm/v1
LITELLM_API_KEY=
LITELLM_MODEL=kimi-k2.6
LITELLM_TRANSCRIBE_MODEL=openai/whisper-1
LITELLM_TIMEOUT_SECONDS=180
# false when gateway cert SAN does not match the host (curl --insecure)
LITELLM_SSL_VERIFY=false

# --- Gemini Live (voice interviewer ONLY — gemini-3.1-flash-live-preview) ----
# Do not reuse this key for picker or grader agents.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Puck
# manual = our gate (default); server_vad = A/B comparison
GATING_MODE=manual
THINKING_PAUSE_MS=900
TURN_END_SILENCE_MS=1800

# --- Voice CAT policy (retuned for fractional voice weights) -----------------
VOICE_SE_TARGET=0.80
VOICE_STABILITY_SE_CEILING=0.95
VOICE_SESSION_TIME_LIMIT_MINUTES=45
ALLOW_TEXT_FALLBACK=true

# Shared CAT defaults (voice package already defaults SE=0.80 / min=4)
CAT_SE_TARGET=0.80
CAT_STABILITY_SE_CEILING=0.95
CAT_MIN_QUESTIONS=4
CAT_MAX_QUESTIONS=12

# --- Observability (optional) ------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=development

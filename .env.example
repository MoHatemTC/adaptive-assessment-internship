# Engine configuration, for running the TESTS and the EVALUATION HARNESS from a checkout.
#
# A deployment does not use this file. `deploy/.env.example` is the one that configures the
# services, and it declares the engine policy once so every service agrees — see
# `docs/microservices.md` on why that agreement is load-bearing.
#
# Every key below is read by `app/config/settings.py` or `app/config/voice_settings.py`.
# The previous version of this file documented Supabase, Qdrant and a database connection
# inherited from a parent project, none of which anything here reads: `extra="ignore"`
# swallowed them silently, so an operator could set them and watch nothing happen.

# ── Which bank, when a caller does not name one ────────────────────────────────
# A bank and its competency graph are selected TOGETHER. Pairing an AI Engineer bank with
# the Data Analysis graph makes every required coverage node unmeasurable and vetoes
# convergence forever, which reads as a measurement fault rather than a configuration one.
ACTIVE_BANK=AIE

# ── LiteLLM proxy ─────────────────────────────────────────────────────────────
# Optional for the test suite: without it selection is deterministic and typed voice uses
# the documented low-confidence heuristic. The suite never calls it.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=openai/gpt-5.6-sol
LITELLM_LIVE_PREVIEW_MODEL=gemini/gemini-3.1-flash-live-preview
# Gateways reached by IP often have a cert SAN mismatch. Setting this false is the one
# knob that turns a TLS error into a silent downgrade — set it deliberately or not at all.
LITELLM_SSL_VERIFY=true

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Real coding-question grading. Its absence is candidate-safe: an infrastructure failure
# produces no evidence and moves no estimate.
E2B_API_KEY=

# ── Where finished sessions are recorded ──────────────────────────────────────
# Empty disables it. This is the ONLY corpus `scripts/validate_prerequisite_edges.py` can
# compute edge validity from, and nothing else persists a finished session. Off by default
# because a dump of assessment states is candidate data.
CAT_SESSION_DUMP_DIR=

# ── Banks as content ──────────────────────────────────────────────────────────
# Where the checked-in banks are read from, and where posted ones are written. Unset, both
# resolve inside the package — which is what a checkout wants and what a container does not.
# ENGINE_DATA_DIR=
# BANK_STORE_DIR=

# ── Propagation ───────────────────────────────────────────────────────────────
# Ships INERT. A completed screening study measured the wrong-inference rate at 7-17%
# against a 3% gate. Enabling either is a per-edge decision with an experimental design
# behind it — `docs/operations.md` has the checklist.
COMPETENCY_GRAPH_ENABLED=true
GRAPH_UPWARD_INFERENCE_ENABLED=false
GRAPH_DESCENDANT_BLOCKING_ENABLED=false
GRAPH_CONVERGENCE_GATE_ENABLED=true

# ── Tracing ───────────────────────────────────────────────────────────────────
# Runtime-optional: without both keys the engine runs untraced and otherwise unaffected.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development

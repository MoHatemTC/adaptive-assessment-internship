# Copy the values you need into Streamlit Cloud → App settings → Secrets.
# Keep this file as an example; never commit a real secrets.toml.

ACTIVE_BANK = "JAI-600"
STREAMLIT_TESTER_MODE = false
ALLOW_TEXT_FALLBACK = true

# With no LiteLLM key, selection remains deterministic and typed voice grading uses its
# documented heuristic fallback. Configure these to test the real picker/voice paths.
LITELLM_BASE_URL = "https://your-litellm-gateway.example.com"
LITELLM_API_KEY = ""
LITELLM_MODEL = "openai/gpt-5.6-sol"
LITELLM_LIVE_PREVIEW_MODEL = "gemini/gemini-3.1-flash-live-preview"
LITELLM_SSL_VERIFY = true

# Required to execute and grade coding submissions. Without it, infrastructure failures
# are shown but deliberately do not change the candidate estimate.
E2B_API_KEY = ""

# Build context is the REPOSITORY ROOT, so each image can copy the shared packages and the
# engine. Everything below would otherwise be shipped into every one of them.

.git
.github
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache

# Virtual environments. A copied Windows venv in particular is both large and unusable.
.venv
.venv-streamlit
**/.venv
venv

# Not runtime. The evaluation harness drives the engine in-process on a workstation and is
# a test instrument, not a component — ADR-0001 is explicit that it will never be a service.
backend/tests
backend/evaluation
backend/eval-results
eval-results
backend/.env
backend/.env.*
**/.env

# Documentation, research artefacts and generated knowledge graphs.
docs
graphify-out
**/graphify-out
*.md
!services/*/MIGRATION.md

# Locally posted banks. A deployment mounts a volume for these.
backend/app/data/banks

# Build leftovers
**/*.egg-info
build
dist

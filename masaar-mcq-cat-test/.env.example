# Copy to .env and fill in. Never commit real keys — .env is gitignored.
#
# Configure ONE backend. If both are present the LiteLLM gateway wins, because
# configuring a gateway is a deliberate act while OPENAI_API_KEY tends to linger from an
# earlier run. Force either explicitly with LLM_PROVIDER.

# --- Option A: LiteLLM gateway (Sprints) ---------------------------------------
# BOTH the key and the base URL are required for the gateway to be selected; a key on
# its own is ignored and the app falls through to OpenAI.
LITELLM_API_KEY=sk-your-litellm-virtual-key
LITELLM_BASE_URL=https://learner-os.sprints.ai/litellm/v1
LITELLM_MODEL=kimi-k2.6
# kimi is a reasoning model: ~20s and ~3k output tokens for one CAT step, so the
# OpenAI-tuned 30s default turns merely-slow calls into "the model failed".
LITELLM_TIMEOUT=180

# --- Option B: OpenAI direct ----------------------------------------------------
# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=30

# Force a backend regardless of what else is set: litellm | openai
# LLM_PROVIDER=litellm

# --- Pricing (optional) ---------------------------------------------------------
# llm_client.py ships prices for the OpenAI models only. A gateway proxies, and its
# contracted rate is not a number to guess, so kimi is deliberately unpriced: the cost
# panel reads "unpriced model" and reports tokens rather than a fabricated dollar
# figure. Set BOTH of these to price a run; they override the built-in table.
# LLM_PRICE_INPUT_PER_1M=0.60
# LLM_PRICE_OUTPUT_PER_1M=2.50

# --- Langfuse tracing (optional) -------------------------------------------------
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

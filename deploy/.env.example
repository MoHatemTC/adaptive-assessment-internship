# Deploy configuration for the seven services.
#
# Two kinds of setting live here and the difference matters.
#
# DEPLOYMENT settings differ per service legitimately — URLs, ports, log levels.
#
# ENGINE POLICY must be IDENTICAL everywhere, because it decides what a candidate is
# SCORED by. A grader running CODE_APPROACH=C beside an orchestrator that believes it is B
# produces a session whose scores were computed one way and whose stopping rule assumed
# another: internally consistent, entirely wrong, and no request fails. The compose file
# declares those once and passes them to every service, and every service reports
# `engine_config_fingerprint` on /health so a mismatch is visible.

LOG_LEVEL=INFO
RELEASE=dev

# --- model access ----------------------------------------------------------------------
# Needed by grader (rubric grading, code interpretation, transcription), by
# assessment-orchestrator (the Picking Agent calls a model on every queue fill — ADR-0001
# said otherwise, see ADR-0002), and by live-voice (the realtime interviewer).
#
# competency-graph needs NO egress at all. That is where the security argument lives.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_LIVE_PREVIEW_MODEL=

# --- sandbox ---------------------------------------------------------------------------
# grader only. Untrusted candidate code runs in E2B, never in a container here.
E2B_API_KEY=

# --- engine policy: identical across services ------------------------------------------
ACTIVE_BANK=AIE
CAT_SE_TARGET=0.55
CAT_MAX_QUESTIONS=12
CODE_APPROACH=B
CODE_RUBRIC=mid
COMPETENCY_GRAPH_ENABLED=true
# Propagation ships INERT. A completed screening study measured its wrong-inference rate
# at 7-17% against a 3% gate. Turning either on is a per-edge decision with an
# experimental design behind it — see docs/operations.md.
GRAPH_UPWARD_INFERENCE_ENABLED=false
GRAPH_DESCENDANT_BLOCKING_ENABLED=false
GRAPH_CONVERGENCE_GATE_ENABLED=true

# --- scoping ---------------------------------------------------------------------------
# An assessment can cover part of a bank rather than all of it. EMPTY DISABLES IT: a request
# carrying a `scope` is then refused, rather than quietly assessed against the whole bank,
# because "you asked for three competencies and got eleven" is not something a candidate or
# a report could detect afterwards.
COMPETENCY_SCOPE_URL=http://competency-scope:8085

# --- bank ingest -------------------------------------------------------------------------
# An author uploads QUESTIONS and never a graph, so one is derived from the items. These two
# govern that derivation, and they are modelling decisions rather than derivations: the right
# values depend on how heavily a bank's items measure more than one competency.
#
# Read at INGEST time. Changing them does not re-derive an existing bank — it changes what
# the next upload produces.
RELATION_THRESHOLD=0.5
EDGE_FLOOR=0.05

# --- where banks live --------------------------------------------------------------------
# EMPTY KEEPS THE FILE STORE, which is the default and what the suite runs against. Set it on
# bank-registry and bank-ingest to resolve banks from Postgres instead:
#
#     docker compose --profile db up --build
#
# The seeds are loaded on boot, idempotently, and land with the same content hash the file
# store computes — which is what keeps every orchestrator cache and every pinned expectation
# valid across the switch.
BANK_DATABASE_URL=

# --- where live assessments live ---------------------------------------------------------
# EMPTY KEEPS THEM IN ONE PROCESS. That is a supported single-replica deployment, and it
# means a restart loses every assessment mid-answer and a second replica cannot serve a
# candidate the first one started. /health reports which mode is in force.
#
# Deliberately a SEPARATE url from BANK_DATABASE_URL even when both point at one server: a
# bank is content that is published and kept; a session is a record of what a person answered
# and has a deletion deadline. One url for both makes the deadline somebody's afterthought.
SESSION_DATABASE_URL=
# false blanks the per-response detail as soon as an assessment ends and keeps the report.
# The report is what anybody reads afterwards; the responses are what make the row personal
# data. Turn it on only with a retention decision behind it.
SESSION_KEEP_RESPONSES=false

# --- surfaces that are off unless you mean it ------------------------------------------
# Can REPLACE the bank a live assessment is running against, and there is no authentication
# on it. Set false wherever the write path is not needed.
#
# TWO WRITE PATHS EXIST TODAY. `ADMIN_API_ENABLED` gates bank-registry's, which takes a bank
# and an AUTHORED graph; `INGEST_API_ENABLED` gates bank-ingest's, which takes one uploaded
# file and derives the graph from it. Turning off one does not turn off the other.
ADMIN_API_ENABLED=true
# bank-ingest's upload path. False stops uploads without stopping the service.
INGEST_API_ENABLED=true
# Posteriors, selection reasoning and raw session state. NOT candidate-safe.
AUTHOR_DIAGNOSTICS_ENABLED=false
# Carries candidate transcripts.
LIVE_DEBUG_API_ENABLED=false
# Typed answers to spoken items. Keeps remote and accessibility testing possible when
# realtime audio is unavailable; it is not the measurement the item was authored for.
ALLOW_TEXT_FALLBACK=false

# --- the frontend ----------------------------------------------------------------------
# Comma-separated origins, or * for open non-credentialed access (the default, and what the
# monolith did). Narrow it wherever something sits behind an origin check.
CORS_ALLOW_ORIGINS=*

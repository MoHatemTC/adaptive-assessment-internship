# Deploy configuration for the five services.
#
# Two kinds of setting live here and the difference matters.
#
# DEPLOYMENT settings differ per service legitimately — URLs, ports, log levels.
#
# ENGINE POLICY must be IDENTICAL everywhere, because it decides what a candidate is
# SCORED by. A grader running CODE_APPROACH=C beside an orchestrator that believes it is B
# produces a session whose scores were computed one way and whose stopping rule assumed
# another: internally consistent, entirely wrong, and no request fails. The compose file
# declares those once and passes them to every service, and every service reports
# `engine_config_fingerprint` on /health so a mismatch is visible.

LOG_LEVEL=INFO
RELEASE=dev

# --- model access ----------------------------------------------------------------------
# Needed by grader (rubric grading, code interpretation, transcription), by
# assessment-orchestrator (the Picking Agent calls a model on every queue fill — ADR-0001
# said otherwise, see ADR-0002), and by live-voice (the realtime interviewer).
#
# competency-graph needs NO egress at all. That is where the security argument lives.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=
LITELLM_LIVE_PREVIEW_MODEL=

# --- sandbox ---------------------------------------------------------------------------
# grader only. Untrusted candidate code runs in E2B, never in a container here.
E2B_API_KEY=

# --- engine policy: identical across services ------------------------------------------
ACTIVE_BANK=AIE
CAT_SE_TARGET=0.55
CAT_MAX_QUESTIONS=12
CODE_APPROACH=B
CODE_RUBRIC=mid
COMPETENCY_GRAPH_ENABLED=true
# Propagation ships INERT. A completed screening study measured its wrong-inference rate
# at 7-17% against a 3% gate. Turning either on is a per-edge decision with an
# experimental design behind it — see docs/operations.md.
GRAPH_UPWARD_INFERENCE_ENABLED=false
GRAPH_DESCENDANT_BLOCKING_ENABLED=false
GRAPH_CONVERGENCE_GATE_ENABLED=true

# --- surfaces that are off unless you mean it ------------------------------------------
# Can REPLACE the bank a live assessment is running against, and there is no authentication
# on it. Set false wherever the write path is not needed.
ADMIN_API_ENABLED=true
# Posteriors, selection reasoning and raw session state. NOT candidate-safe.
AUTHOR_DIAGNOSTICS_ENABLED=false
# Carries candidate transcripts.
LIVE_DEBUG_API_ENABLED=false
# Typed answers to spoken items. Keeps remote and accessibility testing possible when
# realtime audio is unavailable; it is not the measurement the item was authored for.
ALLOW_TEXT_FALLBACK=false

# --- the frontend ----------------------------------------------------------------------
# Comma-separated origins, or * for open non-credentialed access (the default, and what the
# monolith did). Narrow it wherever something sits behind an origin check.
CORS_ALLOW_ORIGINS=*

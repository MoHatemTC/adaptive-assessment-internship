# ── Supabase ───────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co
# Settings → API → anon/public key
SUPABASE_KEY=your-supabase-anon-key
# Settings → API → service_role key (never expose to frontend)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
CONNECT_TO_DB=true

# ── LiteLLM Proxy ──────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-proxy-key
LITELLM_MODEL=openai/gpt-5.6-sol
LITELLM_EMBEDDING_MODEL=text-embedding-004

# ── Gemini (direct — Live WebSocket API only) ──────────
GEMINI_API_KEY=your-gemini-api-key

# ── Qdrant Cloud ───────────────────────────────────────
QDRANT_URL=https://[cluster-id].[region].gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=masar_questions

# ── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
# Must be from a domain verified in Resend dashboard
REPORT_FROM_EMAIL=masar@yourdomain.com
# Comma-separated admin inboxes for completion alerts
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── E2B (code sandboxes) ───────────────────────────────
E2B_API_KEY=your-e2b-api-key

# ── Langfuse (observability) ───────────────────────────
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ────────────────────────────────────────────────
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=change-this-to-a-long-random-secret

LITELLM_SSL_VERIFY=false

# Live interviewer ONLY (open/voice). Grading/picking use LiteLLM.
GEMINI_LIVE_MODEL=gemini-3.1-flash-preview

LITELLM_LIVE_PREVIEW_MODEL=gemini/gemini-3.1-flash-live-preview

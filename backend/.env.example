# LLM access. All calls route through the LiteLLM proxy, as in the parent project.
LITELLM_BASE_URL=https://your-gateway/litellm/v1
LITELLM_API_KEY=sk-your-virtual-key
LITELLM_MODEL=kimi-k2.6
# Reasoning models take ~20s for one selection call; a shorter timeout reports slow
# calls as failures and silently drops the assessment onto the deterministic path.
LITELLM_TIMEOUT_SECONDS=180

# --- CAT policy (defaults shown; see app/config/settings.py for the reasoning) ---
# CAT_SE_TARGET=0.65
# CAT_MAX_QUESTIONS=12
# CAT_MIN_QUESTIONS=6
# CAT_STABLE_WINDOW=3
# CAT_STABILITY_SE_CEILING=0.80
# CAT_CONTENT_BALANCE_FLOOR=0.80
# CAT_EXPOSURE_TOP_K=3
# CAT_REPHRASING_ENABLED=false

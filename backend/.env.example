# LLM access. All calls route through the LiteLLM proxy, as in the parent project.
LITELLM_BASE_URL=https://your-gateway/litellm/v1
LITELLM_API_KEY=sk-your-virtual-key
LITELLM_MODEL=kimi-k2.6
# Reasoning models take ~20s for one selection call; a shorter timeout reports slow
# calls as failures and silently drops the assessment onto the deterministic path.
LITELLM_TIMEOUT_SECONDS=180

# --- CAT policy (defaults shown; see app/config/settings.py for the reasoning) ---
# CAT_SE_TARGET=0.65
# CAT_MAX_QUESTIONS=12
# CAT_MIN_QUESTIONS=6
# CAT_STABLE_WINDOW=3
# CAT_STABILITY_SE_CEILING=0.80
# CAT_CONTENT_BALANCE_FLOOR=0.80
# CAT_EXPOSURE_TOP_K=3
# CAT_REPHRASING_ENABLED=false

# --- code engine -------------------------------------------------------------
# Untrusted code execution. Required: without it no submission can be run.
E2B_API_KEY=

# Scoring policy. B is the measured default: test results own functional correctness,
# the model judges quality. A is objective-only, C is model-led.
CODE_APPROACH=B
CODE_RUBRIC=mid

# Optional per-deployment override of the logic/LLM split, applied on top of the preset.
# Whatever is in force is fingerprinted onto every score.
# CODE_LLM_SHARES={"code_quality": 0.5, "algorithm_choice": 0.2}

# Call the model for diagnosis even when it holds no share of the score.
CODE_LLM_DIAGNOSIS_WHEN_UNWEIGHTED=false

# Trial runs: a candidate may execute their solution against the question's PUBLIC example
# cases before submitting. Hidden cases are never reachable and nothing here is graded.
# CODE_TRIAL_RUN_TESTS=3
# CODE_TRIAL_RUNS_PER_QUESTION=5

# --- observability -----------------------------------------------------------
# Langfuse tracing. Off unless BOTH keys are set; a public key alone cannot authenticate.
# Tracing is never load-bearing — a missing package, a bad key or an unreachable collector
# disables it and changes nothing else. Candidate source code is never sent.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# Keeps a tester's traces separable from a real cohort's inside one project.
# LANGFUSE_ENVIRONMENT=development

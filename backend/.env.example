# ── Supabase ───────────────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://[project-ref].supabase.co
# Settings → API → anon/public key
SUPABASE_KEY=your-supabase-anon-key
# Settings → API → service_role key (never expose to frontend)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
CONNECT_TO_DB=true

# ── LiteLLM Proxy ──────────────────────────────────────
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-proxy-key
LITELLM_MODEL=openai/gpt-5.6-sol
LITELLM_EMBEDDING_MODEL=text-embedding-004

# ── Gemini (direct — Live WebSocket API only) ──────────
GEMINI_API_KEY=your-gemini-api-key

# ── Qdrant Cloud ───────────────────────────────────────
QDRANT_URL=https://[cluster-id].[region].gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=masar_questions

# ── Email (Resend) ─────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
# Must be from a domain verified in Resend dashboard
REPORT_FROM_EMAIL=masar@yourdomain.com
# Comma-separated admin inboxes for completion alerts
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# ── E2B (code sandboxes) ───────────────────────────────
E2B_API_KEY=your-e2b-api-key

# ── Langfuse (observability) ───────────────────────────
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ────────────────────────────────────────────────
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=change-this-to-a-long-random-secret

LITELLM_SSL_VERIFY=false

# ── Adaptive assessment policy ──────────────────────────
# Do not let a short run of high-discrimination/easy items finalize a competency before
# the engine has had enough turns to escalate difficulty and corroborate the level.
CAT_PRECISION_MIN_QUESTIONS=6
CAT_MIN_QUESTIONS=6
CAT_MAX_QUESTIONS=12
CAT_STABILITY_SE_CEILING=0.55
CAT_DIFFICULTY_CORROBORATION_SLACK=0.25
CAT_CHALLENGE_DIFFICULTY_WINDOW=0.75

# Graph-augmented CAT: block precision/stable-band convergence until every required
# sub-competency has direct success or failure evidence (inferred mastery does not count).
GRAPH_CONVERGENCE_GATE_ENABLED=true
GRAPH_COVERAGE_CRITICAL_ONLY=false
GRAPH_SHADOW_MODE=true

# Live interviewer ONLY (open/voice). Grading/picking use LiteLLM.
GEMINI_LIVE_MODEL=gemini-3.1-flash-preview

LITELLM_LIVE_PREVIEW_MODEL=gemini/gemini-3.1-flash-live-preview

# ── Live interviewer helper (open/voice) ───────────────
# Streamlit talks to LIVE_SERVER_BASE (server-side health + room APIs).
# The candidate browser loads LIVE_PUBLIC_BASE/interview (iframe + WebSocket).
# Local defaults (omit both): http://127.0.0.1:8765
#
# Same-VM cloud (helper bound 0.0.0.0:8765, public DNS/TLS in front):
#   LIVE_SERVER_BASE=http://127.0.0.1:8765
#   LIVE_PUBLIC_BASE=https://your-live-host.example.com
#
# Streamlit Cloud cannot run the Live helper — the app uses in-app spoken Live
# via LiteLLM realtime instead (no LIVE_* needed). Optional duplex helper:
#   LIVE_SERVER_BASE=https://your-live-host.example.com
#   LIVE_PUBLIC_BASE=https://your-live-host.example.com
# Typed answers only if explicitly enabled:
#   ALLOW_TEXT_FALLBACK=true
LIVE_SERVER_BASE=
LIVE_PUBLIC_BASE=
ALLOW_TEXT_FALLBACK=false

# Minimal local/Streamlit human-test configuration. Copy to backend/.env and add keys.
ACTIVE_BANK=JAI-600

# false is candidate-safe; true exposes queue math, diagnostics, and grader detail to a
# trusted assessment author. Never enable tester mode on a candidate-facing public app.
STREAMLIT_TESTER_MODE=false

# Keeps voice questions answerable when realtime audio or a separate helper is unavailable.
ALLOW_TEXT_FALLBACK=true

# Optional. Without LiteLLM, selection is deterministic and typed voice uses a low-
# confidence heuristic fallback.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=openai/gpt-5.6-sol
LITELLM_LIVE_PREVIEW_MODEL=gemini/gemini-3.1-flash-live-preview
LITELLM_SSL_VERIFY=true

# Required for real coding-question grading. Infrastructure failure is candidate-safe:
# it produces no evidence and does not move theta.
E2B_API_KEY=

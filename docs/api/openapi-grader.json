      "GradedOutcomeDTO": {
        "description": "One graded statement about one variable, from any modality. The narrow waist.\n\n`weight` is how much of an observation this is worth, in [0, 1], and it is separate\nfrom `score` on purpose: a submission that failed to compile scores 0 but demonstrates\nvery little, and punishing a competency at full strength for a typo measures the wrong\nthing. Weight 0 means the response carries no evidence and must move nothing.",
        "properties": {
          "confidence": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "modality": {
            "anyOf": [
              {
                "enum": [
                  "mcq",
                  "code",
                  "open",
                  "voice"
                ],
                "type": "string"
              },
              {
                "const": "",
                "type": "string"
              }
            ],
            "default": "",
            "title": "Modality"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "source_item_id": {
            "default": "",
            "title": "Source Item Id",
            "type": "string"
          },
          "variable": {
            "title": "Variable",
            "type": "string"
          },
          "weight": {
            "default": 1.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Weight",
            "type": "number"

    "schemas": {
      "BankItemFull": {
        "description": "A ref plus the modality payload. For rendering and for grading, never for ranking.\n\nThe payload stays an open dict because the GRADER owns its shape \u2014 forcing it through\na union here would make every new modality a change to this file and to everything\nthat imports it, which is the coupling the envelope split exists to avoid.",
        "properties": {
          "cat": {
            "$ref": "#/components/schemas/CatParameters"
          },
          "competency": {
            "default": "",
            "title": "Competency",
            "type": "string"
          },
          "estimated_time_seconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Time Seconds"
          },
          "item_id": {
            "title": "Item Id",
            "type": "string"
          },
          "measures": {
            "items": {
              "$ref": "#/components/schemas/MeasuredVariableRef"
            },
            "minItems": 1,
            "title": "Measures",
            "type": "array"
          },
          "minimum_success_confidence": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum Success Confidence"
          },
          "modality": {
            "enum": [
              "mcq",
              "code",
              "open",
              "voice"
            ],
            "title": "Modality",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "status": {
            "default": "active",
            "title": "Status",
            "type": "string"
          },
          "sub_competency": {
            "default": "",
            "title": "Sub Competency",
            "type": "string"
          }
        },
        "required": [
          "item_id",
          "modality",
          "measures",
          "cat"
        ],
        "title": "BankItemFull",
        "type": "object"
      },

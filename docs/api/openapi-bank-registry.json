  "info": {
    "description": "bank-registry \u2014 items, banks, competency graphs and the propagation policy.\n\nTWO READ PATHS, ON PURPOSE\n\n`GET /banks/{id}/items` returns parameters and never payloads; `GET /banks/{id}/items/{id}`\nreturns the payload too. A caller that only ranks should not be able to read a question,\nand that is a property of which endpoint it is allowed to call rather than of what it\nchooses to look at. The orchestrator uses the first for every decision and the second only\nfor the item it is about to present; the grader uses only the second.\n\nA WRITE PATH, WHICH IS NEW\n\nBanks used to be a dict in a Python file. They are content, not code, so another service\ncan now register one. Everything a posted bank has to satisfy is checked BEFORE it is\nwritten \u2014 the same invariants the engine's own suite asserts of the five checked-in banks,\nbecause otherwise that suite is testing the seeds rather than the system.\n\nNO AUTHENTICATION. This carries the monolith's posture forward unchanged and is recorded\nas a gap in ADR-0002 and docs/operations.md, not implied. `ADMIN_API_ENABLED=false` turns\nthe write path off without turning off the service, because a read-only registry and one\nthat can replace the bank a live assessment is running against are different propositions.\n",
    "summary": "Items, banks, competency graphs and the propagation policy.",
    "title": "bank-registry",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/banks": {
      "get": {
        "operationId": "list_banks_banks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BankSummary"
                  },
                  "title": "Response List Banks Banks Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Every registered bank, seeded or posted",
        "tags": [
          "banks"
        ]
      },
      "post": {
        "description": "Refuses an id that already exists, INCLUDING one of the five checked-in banks. Replacing an existing bank is a PUT, so overwriting one is never something a retried POST can do by accident.",
        "operationId": "create_bank_banks_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankSubmission"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankValidationReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "no such bank or item"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
